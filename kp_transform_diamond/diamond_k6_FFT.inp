&GLOBAL
  PROJECT diamond_k6_FFT
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &KPOINTS
      SCHEME MONKHORST-PACK 6 6 6
      RSKP_TRANSFORM FFT
    &END KPOINTS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &SCF
      EPS_SCF 1.0E-12
      MAX_SCF 5
      IGNORE_CONVERGENCE_FAILURE
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 0.0000 1.7835 1.7835
      B 1.7835 0.0000 1.7835
      C 1.7835 1.7835 0.0000
    &END CELL
    &COORD
      C 0.0000 0.0000 0.0000
      C 0.89175 0.89175 0.89175
    &END COORD
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
